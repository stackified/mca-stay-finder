# All keys are OPTIONAL. The app works without any of them.
# Copy this file to .env.local and fill in only what you use. Never commit .env.local.

# CPCB real-time AQI via data.gov.in (free key on sign-up). Phase 6, optional.
VITE_DATA_GOV_IN_KEY=

# OpenAQ v3 (free key). Phase 6, optional.
VITE_OPENAQ_KEY=

# openrouteservice (free key, daily quota) for travel time. Optional; fallback = straight line x 1.3.
VITE_ORS_KEY=
